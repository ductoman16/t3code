{
  "manifest_version": 2,
  "name": "T3 Code Voice Ducking",
  "version": "1.0.0",
  "description": "Turns down audio playing in Firefox while T3 Code (Voice) voice mode is talking, and restores it after.",
  "browser_specific_settings": {
    "gecko": {
      "id": "voice-audio-ducking@t3code.voice",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["http://127.0.0.1/*"],
  "background": { "page": "background.html", "persistent": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
